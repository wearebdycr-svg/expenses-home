{
  "name": "expenses-home",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:env": "node scripts/set-env.js",
    "config:env:dev": "node scripts/set-env.js --env=dev",
    "config:env:prod": "node scripts/set-env.js --env=prod",
    "prestart": "node scripts/set-env.js",
    "start": "ng serve",
    "prebuild": "node scripts/set-env.js",
    "build": "ng build",
    "build:dev": "npm run config:env:dev && ng build",
    "build:prod": "npm run config:env:prod && ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/set-env.js",
    "test": "node scripts/set-env.js && ng test",
    "pretest:ci": "node scripts/set-env.js",
    "test:ci": "node scripts/set-env.js && ng test --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "audit": "npm audit --audit-level=high",
    "cap:sync": "npx cap sync android",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "npm run cap:build && ./android/gradlew -p android assembleDebug",
    "apk:release": "npm run cap:build && ./android/gradlew -p android assembleRelease",
    "apk:dev": "npm run config:env:dev && npm run build && npx cap sync android && ./android/gradlew -p android assembleDebug",
    "apk:prod": "npm run config:env:prod && npm run build && npx cap sync android && ./android/gradlew -p android assembleRelease"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.117.2",
    "chart.js": "^4.5.1",
    "firebase": "^12.19.0",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/cli": "^8.5.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.8"
  }
}
